CONFIG_ZION_FACTORY_SIZE=3416064
CONFIG_ESP_WIFI_DPP_SUPPORT=y
# Passport OS uses real DFS/light-sleep locks; these must match the SDK build.
# Enabling PM leaves automatic light sleep off until an application opts in.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
# A child can opt into automatic light sleep. Keep the USB test/update channel
# awake while attached, as Passport OS's original native SDK config requires.
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
# Passport OS needs an indivisible 48 KiB workspace: move BLE controller code
# to Flash rather than sacrificing original application data or callback ABI.
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
# Passport OS draws JPEG cards/icons from its in-memory filesystem paths.
CONFIG_LV_USE_TJPGD=y
CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FS_MEMFS_LETTER=77
# Liuyao's standby rings require the real LVGL arc widget, shared by plugins.
CONFIG_LV_USE_ARC=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.with-xiaozhi.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.with-xiaozhi.csv"
CONFIG_BOARD_TYPE_FOLOTOY_AI_PASSPORT=y
CONFIG_LANGUAGE_ZH_CN=y
CONFIG_FLASH_NONE_ASSETS=y
CONFIG_USE_HOTSPOT_WIFI_PROVISIONING=y
CONFIG_WAKE_WORD_DISABLED=y
CONFIG_XIAOZHI_COMPACT_FONT=y
CONFIG_XIAOZHI_TEXT_ONLY=y
CONFIG_XIAOZHI_SILENT_PROMPTS=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_DEFAULT_UNSCII_8=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_USE_FONT_PLACEHOLDER=n
CONFIG_LV_USE_LODEPNG=n
CONFIG_LV_USE_IMGFONT=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n
CONFIG_LWIP_IPV6=n
# Native ET_REL modules execute from C3's IRAM alias of dynamically allocated RAM.
# This flat, trusted-code experiment does not provide process isolation.
CONFIG_ESP_SYSTEM_MEMPROT=n

CONFIG_LV_FONT_MONTSERRAT_20=y

CONFIG_LV_USE_THEME_DEFAULT=y

# Shared application BLE HID providers and persistent bonds.
CONFIG_BT_NIMBLE_HID_SERVICE=y
CONFIG_BT_NIMBLE_SVC_HID_MAX_INSTANCES=1
CONFIG_BT_NIMBLE_SVC_HID_MAX_RPTS=4
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
# Connect Four's unchanged dual-role BLE transport needs GATT client discovery,
# not just the observer role used by V-Pet. Missing providers failed real linking.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y

# Register only the shared decoders used by accepted apps.
CONFIG_AUDIO_DECODER_AAC_SUPPORT=n
CONFIG_AUDIO_DECODER_G711_SUPPORT=n
CONFIG_AUDIO_DECODER_AMRNB_SUPPORT=n
CONFIG_AUDIO_DECODER_AMRWB_SUPPORT=n
CONFIG_AUDIO_DECODER_FLAC_SUPPORT=n
CONFIG_AUDIO_DECODER_VORBIS_SUPPORT=n
CONFIG_AUDIO_DECODER_ADPCM_SUPPORT=n
CONFIG_AUDIO_DECODER_ALAC_SUPPORT=n
CONFIG_AUDIO_DECODER_PCM_SUPPORT=n
CONFIG_AUDIO_DECODER_SBC_SUPPORT=n
CONFIG_AUDIO_DECODER_LC3_SUPPORT=n
CONFIG_AUDIO_DECODER_G722_SUPPORT=n
CONFIG_AUDIO_SIMPLE_DEC_WAV_SUPPORT=n
CONFIG_AUDIO_SIMPLE_DEC_M4A_SUPPORT=n
CONFIG_AUDIO_SIMPLE_DEC_TS_SUPPORT=n
CONFIG_AUDIO_SIMPLE_DEC_OGG_SUPPORT=n
CONFIG_AUDIO_DECODER_MP3_SUPPORT=y
CONFIG_AUDIO_DECODER_OPUS_SUPPORT=y

# Keep RX hot paths in Flash to recover RAM for no-PSRAM applications.
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_IRAM_OPT=n

# Six static RX buffers retain DMA headroom alongside audio and LVGL.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_LV_FONT_MONTSERRAT_16=y
